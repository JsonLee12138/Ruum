#!/bin/sh
set -eu

HERE=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
APPDIR=${APPDIR:-"$HERE"}
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

if [ "${RUUM_ASKPASS_CMD-}" = "ssh-askpass" ]; then
    exec "$APPDIR/usr/bin/ruum" "$@"
fi

case "${1-}" in
    help|-h|--help|scan|ssh|config|watchdog|analyze|mcp|extract-scanner|ssh-askpass|update|space|run-script)
        exec "$APPDIR/usr/bin/ruum" "$@"
        ;;
    *)
        exec "$APPDIR/usr/bin/ruum-gui" "$@"
        ;;
esac

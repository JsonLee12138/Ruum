#!/bin/sh
set -eu

HERE=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
APPDIR=${APPDIR:-"$HERE"}

if [ "${RUUM_ASKPASS_CMD-}" = "ssh-askpass" ]; then
    exec "$APPDIR/usr/bin/ruum" "$@"
fi

case "${1-}" in
    help|-h|--help|scan|ssh|config|watchdog|analyze|mcp|extract-scanner|ssh-askpass)
        exec "$APPDIR/usr/bin/ruum" "$@"
        ;;
    *)
        exec "$APPDIR/usr/bin/ruum-gui" "$@"
        ;;
esac

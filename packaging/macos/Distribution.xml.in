<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>ruum @VERSION@</title>
    <organization>io.github.tobi.ruum</organization>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
    <options customize="never" require-scripts="false" hostArchitectures="@HOST_ARCH@"/>
    <pkg-ref id="io.github.tobi.ruum.pkg"/>
    <choices-outline>
        <line choice="default">
            <line choice="io.github.tobi.ruum"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="io.github.tobi.ruum" visible="false">
        <pkg-ref id="io.github.tobi.ruum.pkg"/>
    </choice>
    <pkg-ref id="io.github.tobi.ruum.pkg" version="@VERSION@" onConclusion="none">ruum-component.pkg</pkg-ref>
</installer-gui-script>

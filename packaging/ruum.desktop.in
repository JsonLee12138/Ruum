[Desktop Entry]
Type=Application
Version=1.0
Name=ruum
GenericName=Disk space treemap
Comment=Find what is using a volume, mark what should go, remove it
Exec=@BINDIR@/ruum %f
Icon=ruum
Terminal=false
Categories=System;Filesystem;
Keywords=disk;space;usage;du;treemap;cleanup;
StartupNotify=true
StartupWMClass=ruum
# Registered for directories, so a file manager can offer "Open with ruum".
# This adds a handler; it does not become the default.
MimeType=inode/directory;
Actions=disk;
X-AppVersion=@VERSION@

[Desktop Action disk]
Name=Scan the whole disk
Exec=@BINDIR@/ruum --disk
